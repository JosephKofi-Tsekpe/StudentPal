OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
PORT=8000
# Runtime: pooled Neon Postgres URL including sslmode=require.
DATABASE_URL=
# Optional direct Neon URL used for migrations; otherwise DATABASE_URL is used.
DATABASE_URL_UNPOOLED=
DIRECT_URL=
# Neon Object Storage credentials (private bucket).
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=assets
# Required stable random secret (at least 32 characters). Never commit a real value.
BETTER_AUTH_SECRET=
# Optional: defaults to Render HTTPS hostname, or local http://127.0.0.1:8000.
BETTER_AUTH_URL=
# Optional existing test account for npm run test:neon.
NEON_TEST_EMAIL=
NEON_TEST_PASSWORD=
